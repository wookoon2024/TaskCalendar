{
  "manifest_version": 3,
  "name": "TaskCalendar Browser Bridge",
  "version": "0.1.0",
  "description": "Adds an import button beside matching page titles and sends schedules to TaskCalendar.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "TaskCalendar Browser Bridge"
  }
}
