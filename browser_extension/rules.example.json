{
  "bridgeBaseUrl": "http://127.0.0.1:18452",
  "rules": [
    {
      "id": "my-classroom-page",
      "enabled": true,
      "urlPatterns": [
        "https://service.example.com/.*"
      ],
      "requiredSelectors": [
        "h1.page-title",
        ".lecture-date"
      ],
      "requiredTexts": [
        "강의 정보"
      ],
      "forbiddenSelectors": [],
      "titleSelector": "h1.page-title",
      "buttonContainerSelector": "h1.page-title",
      "descriptionSelectors": [
        ".lecture-summary",
        ".teacher-name"
      ],
      "dateSelector": ".lecture-date",
      "timeSelector": ".lecture-time",
      "allDay": false,
      "iconType": "important",
      "alertType": "popup",
      "alertOffset": "30m",
      "fingerprintSelector": "[data-lecture-id]",
      "fingerprintPrefix": "classroom",
      "buttonText": "일정 추가하기"
    }
  ]
}
