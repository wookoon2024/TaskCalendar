{
  "manifest_version": 3,
  "name": "TaskCalendar 연동",
  "version": "1.13.0",
  "description": "웹 페이지에서 K캘린더로 일정/업무/메모를 바로 등록합니다",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "tabs"],
  "action": {
    "default_title": "TaskCalendar에 등록 (Alt+Shift+C)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "open-taskcalendar-add": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "현재 페이지를 TaskCalendar에 등록"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
