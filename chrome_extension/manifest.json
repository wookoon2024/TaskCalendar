{
  "manifest_version": 3,
  "name": "바로업무로 보내기",
  "version": "1.17.1",
  "description": "웹 페이지에서 바로업무로 일정/업무/메모를 등록하고, 페이지별 플로팅 메모를 남깁니다",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "바로업무로 보내기 (Ctrl+Shift+K)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "open-taskcalendar-add": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "마우스 위치 항목을 바로업무로 보내기"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js", "page_memo.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "options_page": "memo_manager.html",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
